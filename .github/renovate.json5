{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    // Disable the dependency dashboard: avoids Renovate opening a tracking issue
    // in every target repository.
    // Needs to be disabled twice, see https://github.com/renovatebot/renovate/discussions/31221#discussioncomment-10551423
    ":disableDependencyDashboard"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex"
  ],
  "labels": [
    "dependencies-update",
    "renovate"
  ],
  // Central config: each target repository does not need its own renovate.json.
  // Renovate will run on any repository it is pointed at without requiring onboarding.
  onboarding: false,
  requireConfig: "ignored",
  // Disable the dependency dashboard: avoids Renovate opening a tracking issue
  // in every target repository.
  // Needs to be disabled twice, see https://github.com/renovatebot/renovate/discussions/31221#discussioncomment-10551423
  dependencyDashboard: false,
  // Limit PRs to 5 at a time to avoid overwhelming maintainers.
  prConcurrentLimit: 5,
  prHourlyLimit: 0,
  // Avoid collisions with already-existing Renovate branches/PRs from other
  // base branches (important for dry-run scenario tests).
  additionalBranchPrefix: "{{baseBranch}}-",
  // Override default weekly schedule from config:recommended so Renovate
  // runs every time the workflow triggers.
  schedule: [
    "at any time"
  ],
  // Target repositories may use path-prefixed tags for in-repo composite actions and
  // reusable workflows (e.g. "dummy-workflow/v1.3.0", "dummy-composite/v1.2.0").
  // The native github-actions manager rejects these tags because its default semver
  // versioning cannot parse the path prefix, and packageRules.extractVersion does not
  // apply at extraction time. The unified custom regex manager below handles all
  // path-prefixed self-references automatically, so no per-action or per-workflow entries
  // are needed. It captures the action/workflow path and the tag prefix dynamically
  // via named groups, so any new action or workflow using this convention is covered
  // without config changes.
  //
  // The two forms handled:
  //   Pinned-digest: uses: owner/repo/<path>@<sha> # <prefix>/<version>
  //   Tag-as-ref:    uses: owner/repo/<path>@<prefix>/<version>
  "customManagers": [
    {
      // Unified handler for both forms:
      //   1) pinned-digest: uses: owner/repo/<path>@<sha> # <prefix>/<version>
      //   2) tag-as-ref:    uses: owner/repo/<path>@<prefix>/<version>
      // Keeping both forms in one manager avoids cross-manager transformations
      // where one replacement changes text into another manager's pattern.
      // Goal: produce one consistent semver-compatible update stream for
      // path-prefixed in-repo action/workflow references.
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/",
        "/^\\.github/actions/.+/action\\.ya?ml$/",
      ],
      "matchStrings": [
        "uses: (?<depName>[^/\\s]+/[^/\\s]+)/(?<actionPath>[^@\\s]*[^/@\\s])/?@(?:(?<currentDigest>[0-9a-f]{40}) # )?(?<currentValue>[^/\\s]+/\\S+)"
      ],
      // Use a path-specific dependency identity to avoid grouping unrelated
      // references from the same repository (e.g. dummy-composite vs
      // dummy_reusable_workflow) into one branch update.
      "depNameTemplate": "{{{depName}}}/{{{actionPath}}}",
      // Keep release lookup on the underlying repository tags.
      "packageNameTemplate": "{{{depName}}}",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^(?<compatibility>[^/]+)/v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      // Render path-prefixed refs as uses: owner/repo/path@<sha> # <prefix>/vX.Y.Z.
      // This preserves the prefix context while pinning to the resolved digest.
      "autoReplaceStringTemplate": "uses: {{{depName}}}@{{{newDigest}}} # {{{newValue}}}"
    }
  ],
  "packageRules": [
    {
      "description": "Allow minor and patch updates for non-ETAS GitHub Actions dependencies; release-age delay is intentionally disabled for the current test workflow.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      // Match against the full dependency reference (e.g. owner/repo or owner/repo/path/to/workflow).
      // Regex-string form is required by matchPackageNames.
      "matchPackageNames": [
        "!/^etas.+/"
      ],
      // Keep release age disabled until the update workflow is stabilized.
      //"minimumReleaseAge": "3 days",
    },
    {
      "description": "Allow minor and patch updates for ETAS GitHub Actions dependencies without release-age gating.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      // Match against the full dependency reference (e.g. owner/repo or owner/repo/path/to/workflow).
      // Regex-string form is required by matchPackageNames.
      "matchPackageNames": [
        "/^etas.+/"
      ]
    },
    {
      // Keep semver bump style updates and SHA pinning, but avoid standalone
      // digest-only refresh branches that keep a broad comment such as "# v4".
      "description": "Disable digest-only updates across github-actions and custom.regex to avoid standalone digest refresh PRs.",
      "matchManagers": [
        "github-actions",
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "enabled": false
    },
    {
      // Ensure path-prefixed refs are resolved and pinned by the custom.regex
      // manager (e.g. @dummy-composite/v1.0.0 -> @<sha> # dummy-composite/v1.2.0).
      // This targets only prefix-based refs and does not affect regular tags.
      "description": "For custom.regex path-prefixed tags, enable digest pinning so semver updates resolve to explicit commits.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchCurrentValue": "/^[^/\\s]+\\/\\S+$/",
      "pinDigests": true
    },
    {
      // Avoid standalone pin-only translations for path-prefixed refs
      // (e.g. @dummy-composite/v1.0.0 -> @<sha> # dummy-composite/v1.0.0).
      // Keep semver minor/patch updates, which still include digest pinning
      // to the newer compatible version.
      "description": "Disable custom.regex pinDigest-only updates for path-prefixed refs to prevent duplicate tag-to-same-version commit translations.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchCurrentValue": "/^[^/\\s]+\\/\\S+$/",
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "enabled": false
    },
    {
      // Do not pin tag-based refs in the generic pin-dependencies branch.
      "description": "Disable github-actions pinDigest updates by default to avoid broad pin-dependencies churn.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "enabled": false
    },
    {
      // Re-enable pinDigest only for explicit branch refs.
      "description": "Allow github-actions pinDigest only for explicit branch refs (main/master/develop/development/dev/trunk).",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "matchCurrentValue": "/^(main|master|develop|development|dev|trunk)$/",
      "enabled": true
    },
    {
      "description": "Block major updates for github-actions and custom.regex so only compatible minor and patch updates are proposed.",
      "matchManagers": [
        "github-actions",
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      // Disable the native github-actions manager for path-prefixed tags so they
      // are not extracted and reported as unparseable.
      "description": "Disable native github-actions handling of path-prefixed tags so only custom.regex processes them.",
      "matchManagers": [
        "github-actions"
      ],
      "matchCurrentValue": "/^[^/\\s]+\\/\\S+$/",
      "enabled": false
    },
    {
      "description": "Disable Docker datasource updates in github-actions files to keep this configuration focused on action and workflow references.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "docker"
      ],
      "enabled": false
    },
    {
      "description": "Disable github-runners datasource updates to avoid runner-image churn in this scenario.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "github-runners"
      ],
      "enabled": false
    }
  ]
}
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    // Disable the dependency dashboard: avoids Renovate opening a tracking issue
    // in every target repository.
    // Needs to be disabled twice, see https://github.com/renovatebot/renovate/discussions/31221#discussioncomment-10551423
    ":disableDependencyDashboard"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex"
  ],
  "labels": [
    "dependencies-update",
    "renovate"
  ],

  // Central config: each target repository does not need its own renovate.json.
  // Renovate will run on any repository it is pointed at without requiring onboarding.
  onboarding: false,
  requireConfig: "ignored",

  // Disable the dependency dashboard: avoids Renovate opening a tracking issue
  // in every target repository.
  // Needs to be disabled twice, see https://github.com/renovatebot/renovate/discussions/31221#discussioncomment-10551423
  dependencyDashboard: false,

  // Limit PRs to 5 at a time, to avoid overwhelming maintainers
  prConcurrentLimit: 5,
  prHourlyLimit: 0,

  // Avoid collisions with already-existing Renovate branches/PRs from other
  // base branches (important for dry-run scenario tests).
  additionalBranchPrefix: "{{baseBranch}}-",

  // Override default weekly schedule from config:recommended so Renovate
  // runs every time the workflow triggers.
  schedule: [
    "at any time"
  ],


  // Target repositories may use path-prefixed tags for in-repo composite actions and
  // reusable workflows (e.g. "dummy-workflow/v1.3.0", "dummy-composite/v1.2.0").
  // The native github-actions manager rejects these tags because its default semver
  // versioning cannot parse the path prefix, and packageRules.extractVersion does not
  // apply at extraction time. Two generic custom regex managers below handle ALL
  // path-prefixed self-references automatically — no per-action or per-workflow entries
  // are needed. They capture the action/workflow path and the tag prefix dynamically
  // via named groups, so any new action or workflow using this convention is covered
  // without config changes.
  //
  // The two forms handled:
  //   1) Pinned-digest: uses: owner/repo/<path>@<sha> # <prefix>/<version>
  //   2) Tag-as-ref:    uses: owner/repo/<path>@<prefix>/<version>
  "customManagers": [
    {
      // In-repo composite action refs (pinned-digest and tag-as-ref).
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/",
        "/^\\.github/actions/.+/action\\.ya?ml$/",
      ],
      "matchStrings": [
        "uses: (?<depName>[^/\\s]+/[^/\\s]+)/(?<actionPath>\\.github/actions/[^@\\s]*[^/@\\s])@(?:(?<currentDigest>[0-9a-f]{40}) # )?(?<currentValue>[^/\\s]+/\\S+)"
      ],
      "depNameTemplate": "{{{depName}}}/{{{actionPath}}}",
      "packageNameTemplate": "{{{depName}}}",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^(?<compatibility>[^/]+)/v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "autoReplaceStringTemplate": "uses: {{{depName}}}/{{{actionPath}}}@{{{newDigest}}} # {{{newValue}}}"
    },
    {
      // In-repo reusable workflow refs (pinned-digest and tag-as-ref).
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/",
        "/^\\.github/actions/.+/action\\.ya?ml$/",
      ],
      "matchStrings": [
        "uses: (?<depName>[^/\\s]+/[^/\\s]+)/(?<actionPath>\\.github/workflows/[^@\\s]*[^/@\\s])@(?:(?<currentDigest>[0-9a-f]{40}) # )?(?<currentValue>[^/\\s]+/\\S+)"
      ],
      "depNameTemplate": "{{{depName}}}/{{{actionPath}}}",
      "packageNameTemplate": "{{{depName}}}",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^(?<compatibility>[^/]+)/v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "autoReplaceStringTemplate": "uses: {{{depName}}}/{{{actionPath}}}@{{{newDigest}}} # {{{newValue}}}"
    }
  ],
  "packageRules": [
    {
      "description": "Minor and patch updates for third-party GitHub Actions — 3-day minimum release age to allow time for retracted releases",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      // Match against the full dependency reference (e.g. owner/repo or owner/repo/path/to/workflow).
      // Regex-string form is required by matchPackageNames.
      "matchPackageNames": [
        "!/^etas.+/"
      ],
      // skip release age for the time being, first get the overall update procedure properly set up
      //"minimumReleaseAge": "3 days",
    },
    {
      "description": "Minor and patch updates for ETAS GitHub Actions — no minimum release age required",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      // Match against the full dependency reference (e.g. owner/repo or owner/repo/path/to/workflow).
      // Regex-string form is required by matchPackageNames.
      "matchPackageNames": [
        "/^etas.+/"
      ]
    },
    {
      // Pin to commit SHA only when there is an actual semver update.
      // This avoids standalone regular-tag pinning in pin-dependencies.
      "description": "Pin digests for github-actions during minor/patch updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "pinDigests": true
    },
    {
      // Keep semver bump style updates and SHA pinning, but avoid standalone
      // digest-only refresh branches that keep a broad comment such as "# v4".
      "description": "Disable digest-only updates for GitHub actions/workflows",
      "matchManagers": [
        "github-actions",
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "enabled": false
    },
    {
      // Do not create standalone pin-dependencies updates for prefix-tag refs.
      // Prefix refs should be changed only when there is an actual semver update
      // in their dedicated custom.regex branch.
      "description": "Disable standalone pinDigest updates for custom.regex path-prefixed refs",
      "matchManagers": [
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "enabled": false
    },
    {
      // Do not pin tag-based refs in the generic pin-dependencies branch.
      "description": "Disable pinDigest updates for github-actions by default",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "enabled": false
    },
    {
      // Re-enable pinDigest only for explicit branch refs.
      "description": "Allow pinDigest only for github-actions branch refs",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "matchCurrentValue": "/^(main|master|develop|development|dev|trunk)$/",
      "enabled": true
    },
    {
      "description": "Allow only compatible (minor/patch) GitHub Actions updates by default",
      "matchManagers": [
        "github-actions",
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      // Disable the native github-actions manager for path-prefixed tags so they are not extracted and reported as unparseable
      "description": "Disable native github-actions parsing for path-prefixed tags",
      "matchManagers": [
        "github-actions"
      ],
      "matchCurrentValue": "/^[^/\\s]+\\/\\S+$/",
      "enabled": false
    },
    {
      "description": "Disable Docker image updates referenced from GitHub workflows",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "docker"
      ],
      "enabled": false
    },
    {
      "description": "Disable GitHub runner updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "github-runners"
      ],
      "enabled": false
    }
  ]
}

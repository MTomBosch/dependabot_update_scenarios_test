{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "enabledManagers": [
    "github-actions"
  ],
  "labels": [
    "dependencies",
    "github-actions"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "description": "Minor and patch updates for GitHub Actions with 8-day minimum release age requirement for non-ETAS actions/workflows",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      // Match against the full dependency reference (e.g. owner/repo or owner/repo/path/to/workflow).
      // Use regex-string form required by matchPackageNames.
      "matchPackageNames": [
        "!/^etas.+/"
      ],
      "minimumReleaseAge": "8 days",
      "groupName": "github-actions-compatible"
    },
    {
      "description": "Minor and patch updates for GitHub Actions for ETAS actions/workflows",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      // Match against the full dependency reference (e.g. owner/repo or owner/repo/path/to/workflow).
      // Use regex-string form required by matchPackageNames.
      "matchPackageNames": [
        "/^etas.+/"
      ],
      "groupName": "github-actions-compatible"
    },
    {
      "description": "Disable Docker image updates referenced from GitHub workflows",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "docker"
      ],
      "enabled": false
    },
    {
      "description": "Disable GitHub runner updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "github-runners"
      ],
      "enabled": false
    },
    {
      "description": "Allow only compatible (minor/patch) GitHub Actions updates by default",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex"
  ],
  "labels": [
    "dependencies",
    "github-actions"
  ],

  // Run on all repos, without requiring local renovate.json
  onboarding: false,
  requireConfig: "ignored",

  // Disable the dependency dashboard issue
  dependencyDashboard: false,

  // Limit PRs to 5 at a time, to avoid overwhelming maintainers
  prConcurrentLimit: 5,

  // Override default weekly schedule from config:recommended so Renovate
  // runs every time the workflow triggers.
  schedule: [
    "at any time"
  ],


  // Tags in this repo are path-prefixed (e.g. "dummy-workflow/v1.3.0" / "dummy-composite/v1.2.0").
  // The native github-actions manager cannot parse these (default semver versioning rejects the
  // path prefix), and packageRules.extractVersion does not help there. Two generic custom regex
  // managers below handle ALL path-prefixed self-references automatically — no per-action or
  // per-workflow entries are needed. They capture the action/workflow path and the tag prefix
  // dynamically via named groups, so any new action or workflow using this convention is covered
  // without config changes.
  //
  // The two forms handled:
  //   Pinned-digest: uses: owner/repo/<path>@<sha>       # <prefix>/<version>
  //   Tag-as-ref:    uses: owner/repo/<path>@<prefix>/<version>
  "customManagers": [
    {
      // Handles pinned-digest style: @<sha> # <prefix>/<version>
      // currentValue captures the full prefixed tag (e.g. "dummy-composite/v1.0.0").
      // Regex versioning with a 'compatibility' group restricts comparisons to tags with
      // the same prefix, so dummy-composite and dummy-workflow tags never cross-contaminate.
      // newValue is the full new tag name (e.g. "dummy-composite/v1.2.0"), used directly
      // in the replacement template — no separate tagPrefix group is needed.
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/",
        "/^\\.github/actions/.+/action\\.ya?ml$/",
      ],
      "matchStrings": [
        "uses: (?<depName>[^/\\s]+/[^/\\s]+)/(?<actionPath>[^@\\s]+)@(?<currentDigest>[0-9a-f]{40}) # (?<currentValue>[^/\\s]+/\\S+)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^(?<compatibility>[^/]+)/v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "autoReplaceStringTemplate": "uses: {{{depName}}}/{{{actionPath}}}@{{{newDigest}}} # {{{newValue}}}"
    },
    {
      // Handles tag-as-ref style: @<prefix>/<version> (no digest pinning, tag used directly as ref).
      // After update, converts to the pinned-digest format: @<sha> # <prefix>/<newVersion>.
      // newDigest is resolved via the pinDigests packageRule below.
      // Same regex versioning + compatibility-group approach as the pinned-digest manager above.
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/",
        "/^\\.github/actions/.+/action\\.ya?ml$/",
      ],
      "matchStrings": [
        "uses: (?<depName>[^/\\s]+/[^/\\s]+)/(?<actionPath>[^@\\s]+)@(?<currentValue>[^/\\s]+/\\S+)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^(?<compatibility>[^/]+)/v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "autoReplaceStringTemplate": "uses: {{{depName}}}/{{{actionPath}}}@{{{newDigest}}} # {{{newValue}}}"
    }
  ],
  "packageRules": [
    {
      // Disable the native github-actions manager for path-prefixed tags so they are not extracted and reported as unparseable
      "description": "Disable native github-actions parsing for path-prefixed tags",
      "matchManagers": [
        "github-actions"
      ],
      "matchCurrentValue": "/^[^/\\s]+\\/\\S+$/",
      "enabled": false
    },
    {
      // For the tag-as-ref custom managers (no currentDigest in matchStrings), pinDigests: true
      // instructs Renovate to resolve and populate newDigest (commit SHA) for the new tag,
      // making {{{newDigest}}} available in autoReplaceStringTemplate.
      "description": "Pin digests for custom.regex path-prefixed tag-as-ref references",
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "github-actions",
      "pinDigests": true
    },
    {
      "description": "Minor and patch updates for GitHub Actions with 3-day minimum release age requirement for non-ETAS actions/workflows",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      // Match against the full dependency reference (e.g. owner/repo or owner/repo/path/to/workflow).
      // Use regex-string form required by matchPackageNames.
      "matchPackageNames": [
        "!/^etas.+/"
      ],
      "minimumReleaseAge": "3 days",
      "groupName": "github-actions"
    },
    {
      "description": "Minor and patch updates for GitHub Actions for ETAS actions/workflows, no min release age required",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      // Match against the full dependency reference (e.g. owner/repo or owner/repo/path/to/workflow).
      // Use regex-string form required by matchPackageNames.
      "matchPackageNames": [
        "/^etas.+/"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Disable Docker image updates referenced from GitHub workflows",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "docker"
      ],
      "enabled": false
    },
    {
      "description": "Disable GitHub runner updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "github-runners"
      ],
      "enabled": false
    },
    {
      "description": "Allow only compatible (minor/patch) GitHub Actions updates by default",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
